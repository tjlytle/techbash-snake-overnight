#!/usr/bin/env bash
# bin/pipeline — the agent pipeline for the talk.
#
#   bin/pipeline            watch open issues forever; run each stage's prompt as it is due
#   bin/pipeline --once     one pass over the open issues, then exit (runs keep going)
#   bin/pipeline <#>        run the due stage for one issue now, in the foreground
#   bin/pipeline --status   what is running, what is waiting, what failed
#
# Stages are labels. The loop decides nothing about the work; it maps a label to a
# prompt file and runs that prompt in a headless Claude Code session for the issue:
#
#   stage:todo          backlog, untouched
#   stage:in-progress   pipeline/build.md   (builder: worktree, test, code, draft PR)
#   stage:review        pipeline/review.md  (reviewer: read the PR, approve or send back)
#   stage:qa            pipeline/qa.md      (qa: run every suite, mark ready or send back)
#   stage:done          merged or ready to merge; nothing to do
#   stage:parked        waiting on a human; picked up again when the newest comment is
#                       from a human, and then handed back to the build prompt
#
# `working` is the loop's own label: it is on an issue while a session has it, and comes
# off when that session ends. The stage label says where the issue is; `working` says
# someone has it right now. Each run also has a marker directory, var/pipeline/run-<#>/,
# holding the session's pid, the stage it started from, and the log.
#
# The loop tracks its sessions. When one ends and the stage label has not moved, the
# session is taken to have failed: `working` comes off, the issue stays where it was,
# and the next pass tries again. After MAX_TRIES ends without a move, the issue parks
# with the log tail and @tjlytle, so a stage that keeps dying does not loop forever.
# A `working` label with no live session on this machine is stale and is cleared.
#
# The headless session gets the tool allow list below and nothing more: file edits are
# accepted, and only the listed commands run. A command outside the list is denied and
# the stage stops with that denial in its log, which is the signal to widen the list.
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
REPO=${PIPELINE_REPO:-tjlytle/techbash-snake-overnight}
INTERVAL=${PIPELINE_INTERVAL:-30}
MODEL=${PIPELINE_MODEL:-opus}
MAX_TRIES=${PIPELINE_MAX_TRIES:-3}
HUMAN=${PIPELINE_HUMAN:-tjlytle}
LOG="$ROOT/var/pipeline"
mkdir -p "$LOG"
# The headless session inherits this PATH: gh-as, gh-personas and bot-token come from the
# gh-personas plugin, which interactive sessions put on PATH themselves.
for b in "$HOME"/.claude/plugins/cache/dev-flow/gh-personas/*/bin; do [ -d "$b" ] && PATH="$b:$PATH"; done
export PATH

# The tool allow list lives in pipeline/allow.txt and is read at every launch.
allow_list() { grep -v '^#' "$ROOT/pipeline/allow.txt" | grep -v '^[[:space:]]*$'; }

say() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }

# The session's stream, as lines a room can read: what it says, and each tool call in a few words.
live() {
  jq -R -r --unbuffered '
    (. as $line | try fromjson catch {type: "raw", text: $line}) |
    if .type == "raw" then (.text | select(test("Permission (allow|deny) rule") | not))
    elif .type == "assistant" then
      .message.content[]? | if .type == "text" then .text
        elif .type == "tool_use" then "▶ " + .name + ": " + ((.input.description // .input.command // .input.file_path // .input.pattern // .input.prompt // "") | tostring | .[0:160])
        else empty end
    elif .type == "result" then "■ " + (.subtype // "done") + " after " + ((.num_turns // 0) | tostring) + " turns"
    else empty end'
}

labels_of() { gh issue view "$1" -R "$REPO" --json labels --jq '[.labels[].name] | join(",")'; }
stage_of()  { tr ',' '\n' <<<"$1" | grep '^stage:' | head -1; }
label()     { gh-as - issue edit "$1" -R "$REPO" "$2" "$3" >/dev/null 2>&1; }   # label <#> --add-label|--remove-label <name>

prompt_for() {   # prompt_for <stage> → prompt file name, or empty when nothing is due
  case "$1" in
    stage:in-progress) echo build ;;
    stage:review)      echo review ;;
    stage:qa)          echo qa ;;
    *)                 echo "" ;;
  esac
}

answered() {   # answered <#>: a parked issue whose newest comment is from a human
  local last
  last=$(gh api "repos/$REPO/issues/$1/comments" \
           --jq 'if length == 0 then "" else (last.user.login + " " + last.user.type) end' 2>/dev/null)
  [[ "$last" == *" User" ]]
}

alive() { [ -f "$1/pid" ] && kill -0 "$(cat "$1/pid")" 2>/dev/null; }

finish() {   # finish <#>: the session for <#> has ended; free the issue, judge the outcome
  local n=$1 mark="$LOG/run-$1" before after tries
  [ -d "$mark" ] || return 0
  before=$(cat "$mark/stage" 2>/dev/null)
  after=$(stage_of "$(labels_of "$n")")
  label "$n" --remove-label working
  if [ "$after" != "$before" ]; then
    say "#$n  $before → ${after:-no stage}"
    rm -f "$LOG/$n.tries"
  else
    tries=$(( $(cat "$LOG/$n.tries" 2>/dev/null || echo 0) + 1 ))
    echo "$tries" > "$LOG/$n.tries"
    if [ "$tries" -ge "$MAX_TRIES" ]; then
      say "#$n  ended without moving $tries times; parking it"
      gh-as ops issue comment "$n" -R "$REPO" --body "$(printf '%s\n\n```\n%s\n```' \
        "Pipeline: the $before stage ended $tries times without moving this issue, so I am parking it. @$HUMAN, the log tail:" \
        "$(tail -n 20 "$LOG/$n.log" 2>/dev/null)")" >/dev/null 2>&1
      label "$n" --remove-label "$before"
      label "$n" --add-label stage:parked
      rm -f "$LOG/$n.tries"
    else
      say "#$n  ended without moving ($tries/$MAX_TRIES); it stays in $before and will be retried"
    fi
  fi
  rm -rf "$mark"
}

run_stage() {   # run_stage <#> <title> <stage-label> <prompt>: start a session in the background
  local n=$1 title=$2 stage=$3 prompt=$4 mark="$LOG/run-$1"
  mkdir "$mark" 2>/dev/null || { say "#$n already running"; return 0; }
  echo "$stage" > "$mark/stage"
  label "$n" --add-label working
  local ALLOW; mapfile -t ALLOW < <(allow_list)
  say "#$n  $title  → $prompt ($MODEL)" | tee -a "$LOG/$n.log"
  (
    cd "$ROOT" && claude -p "$(sed "s/{N}/$n/g" "$ROOT/pipeline/$prompt.md")" \
      --model "$MODEL" --permission-mode acceptEdits --allowedTools "${ALLOW[@]}" \
      --output-format stream-json --verbose 2>&1 | tee -a "$LOG/$n.jsonl" | live | sed -u "s/^/  #$n │ /" | tee -a "$LOG/$n.log"
    say "#$n  $prompt session ended" | tee -a "$LOG/$n.log"
    finish "$n"
  ) &
  echo $! > "$mark/pid"
}

reap() {   # sessions that died without running their own finish (loop restarted, kill -9)
  local mark n
  for mark in "$LOG"/run-*; do
    [ -d "$mark" ] || continue
    n=${mark##*/run-}
    alive "$mark" || { say "#$n  session gone; cleaning up"; finish "$n"; }
  done
}

due() {   # due <#> <labels-csv> → prompt to run, or empty
  local n=$1 labels=$2 stage prompt
  stage=$(stage_of "$labels")
  prompt=$(prompt_for "$stage")
  if [ -z "$prompt" ] && [ "$stage" = stage:parked ] && answered "$n"; then
    label "$n" --remove-label stage:parked; label "$n" --add-label stage:in-progress
    stage=stage:in-progress; prompt=build
  fi
  echo "$stage $prompt"
}

pass() {   # one sweep over the open issues
  reap
  while IFS=$'\t' read -r n title labels; do
    [ -z "$n" ] && continue
    if [ -d "$LOG/run-$n" ]; then say "#$n  $title  (running)"; continue; fi
    if [[ ",$labels," == *,working,* ]]; then say "#$n  stale working label; clearing"; label "$n" --remove-label working; fi
    read -r stage prompt <<<"$(due "$n" "$labels")"
    if [ -n "${prompt:-}" ]; then run_stage "$n" "$title" "$stage" "$prompt"
    else say "#$n  $title  [${stage:-no stage}]"; fi
  done < <(gh issue list -R "$REPO" --state open --limit 50 \
             --json number,title,labels \
             --jq '.[] | [.number, .title, ([.labels[].name] | join(","))] | @tsv')
}

status() {
  reap
  local mark n
  for mark in "$LOG"/run-*; do
    [ -d "$mark" ] || continue
    n=${mark##*/run-}
    say "#$n  running $(cat "$mark/stage") since $(date -r "$mark/stage" +%H:%M:%S), pid $(cat "$mark/pid")"
  done
  for t in "$LOG"/*.tries; do [ -f "$t" ] && say "#$(basename "$t" .tries)  $(cat "$t") failed run(s), waiting for a retry"; done
  gh issue list -R "$REPO" --state open --limit 50 --json number,title,labels \
    --jq '.[] | "  #\(.number)  \(.title)  [\([.labels[].name] | join(", "))]"'
}

case "${1:-}" in
  "")        say "watching $REPO every ${INTERVAL}s (ctrl-c stops the loop; sessions already running finish on their own)"
             while true; do pass; sleep "$INTERVAL"; done ;;
  --once)    pass; wait ;;
  --status)  status ;;
  [0-9]*)    reap
             read -r stage prompt <<<"$(due "$1" "$(labels_of "$1")")"
             if [ -n "${prompt:-}" ]; then
               run_stage "$1" "$(gh issue view "$1" -R "$REPO" --json title --jq .title)" "$stage" "$prompt"; wait
             else say "#$1 has nothing due [${stage:-no stage}]"; fi ;;
  *)         sed -n '2,34p' "$0"; exit 2 ;;
esac
